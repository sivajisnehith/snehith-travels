# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=snehith_travels

# --- Security ---
SECRET_KEY=generate_a_random_32_character_hex_secret_here
ENVIRONMENT=production

# --- URLs & CORS ---
# Set to your EC2 Public IP or your custom domain, e.g. http://13.233.100.50 or https://snehithtravels.com
FRONTEND_URL=http://<YOUR_AWS_PUBLIC_IP>
CORS_ORIGINS=*

# Frontend API URL (leave empty when using Nginx reverse proxy so it calls relative /api)
NEXT_PUBLIC_API_URL=

# --- Razorpay Integration ---
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
